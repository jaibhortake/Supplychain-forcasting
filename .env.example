# Copy to backend/.env to override defaults. All settings are optional.
DATABASE_URL=sqlite:///./forecasting.db
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
SEED_ON_STARTUP=true
RANDOM_SEED=42

# Forecasting
BACKTEST_WEEKS=52
BACKTEST_HORIZON=4
ANOMALY_Z_THRESHOLD=2.5

# Local LLM for the "Ask the forecast" assistant
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=300
